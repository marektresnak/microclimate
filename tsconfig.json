{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // Node strips types at runtime rather than compiling, so nothing here may
    // emit code. `erasableSyntaxOnly` enforces that: no enum, no namespace, no
    // parameter properties. Imports carry the .ts extension because that is
    // what Node actually resolves at runtime.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
