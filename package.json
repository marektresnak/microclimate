{
  "name": "microclimate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collects readings from home sensors and drives the HRV unit based on air quality.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "npm run typecheck && node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.1"
  }
}
