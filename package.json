{
  "name": "microclimate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Collects readings from home sensors, serves them over a small JSON API, and sets the HRV unit's fan level over Modbus on request.",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/main.ts",
    "test": "npm run typecheck && node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.0",
    "hono": "^4.13.1"
  }
}
