# Copy to .env and fill in. Never commit .env.

# Tado — OAuth device flow. The refresh token is obtained once, interactively.
TADO_REFRESH_TOKEN=

# Netatmo — OAuth refresh flow against gethomecoachsdata.
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
NETATMO_DEVICE_ID=

# HRV unit (2VV Daphne) — Modbus TCP. Fan speed is register 21001, value = percent * 10.
HRV_MODBUS_HOST=192.168.0.65
HRV_MODBUS_PORT=502
HRV_MODBUS_UNIT_ID=1

# Shared secret the SEN66 push nodes present on POST /api/readings.
INGEST_TOKEN=

# Where the SQLite file lives.
DATABASE_PATH=./data/home.db
