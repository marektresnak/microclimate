# Copy to .env and fill in. Never commit .env.

# The HTTP API and the Netatmo onboarding pages.
PORT=3000

# Tado — OAuth device flow, which has no client secret at all (the client id is
# public and lives in the adapter). So THIS PATH IS TADO'S ON-SWITCH: set it and
# the service polls the real valves, unset and it does not. There is no default,
# and no seed token either — Tado's refresh tokens are single-use, so one pasted
# in here would be spent by the first refresh. Visit /auth/tado once, approve on
# your phone, and the file below is written for you.
TADO_TOKEN_PATH=./data/tado-token.json

# Netatmo — OAuth against gethomecoachsdata. With the client id and secret set,
# the service polls the REAL Home Coach; visit /auth/netatmo once to authorise.
# NETATMO_REFRESH_TOKEN is only a seed for a token obtained elsewhere — the
# browser flow makes it unnecessary, and after the first rotation the token file
# below is the truth.
#
# One switch per vendor, and they are independent: configure Netatmo alone and
# the Tado rooms simply have nothing to say. The synthetic demo sources run only
# while NEITHER vendor is configured, because they write under the same source
# ids as the real adapters — so a demo session against a database you care about
# leaves invented readings in it under real instrument names.
NETATMO_CLIENT_ID=
NETATMO_CLIENT_SECRET=
NETATMO_REFRESH_TOKEN=
NETATMO_DEVICE_ID=

# Where the rotating Netatmo refresh token is persisted. Deliberately a file,
# not a database row — see CLAUDE.md. Defaults next to the database.
NETATMO_TOKEN_PATH=./data/netatmo-token.json

# Must match the Netatmo app registration exactly. Defaults to
# http://localhost:$PORT/auth/netatmo/callback.
NETATMO_REDIRECT_URI=

# HRV unit (2VV Daphne) — Modbus TCP. Fan speed is register 21001, value = percent * 10.
HRV_MODBUS_HOST=192.168.0.65
HRV_MODBUS_PORT=502
HRV_MODBUS_UNIT_ID=1

# There is deliberately no token here for the write endpoints: everything is
# open on the trusted LAN, a recorded decision — see CLAUDE.md.

# Where the SQLite file lives.
DATABASE_PATH=./data/home.db
